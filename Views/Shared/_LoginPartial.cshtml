@using Microsoft.AspNetCore.Identity
@using SewSew.Areas.Identity.Data

@inject SignInManager<SewSewUser> SignInManager
@inject UserManager<SewSewUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post" id="logoutForm" class="nav">
        <div class="col-md-6" style="margin: 0 auto;">
            <ul id="nav-menu">
                <li class="nav-item">
                    <a asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">My Account</a>
                </li>
                <li class="nav-item">
                    <button type="submit" class="btn btn-light-gray">Logout</button>
                </li>
            </ul>
        </div>
    </form>
}
else
{
    <ul id="nav-menu">
        <li class="nav-item">
            <a asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
        <li class="nav-item">
            <a asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
    </ul>
 }
